# DevPulse environment template.
#
# Copy to `.env.local` and fill in what you use. Every variable here is
# optional: DevPulse is local-first and degrades gracefully when a source is
# not configured (the GitHub job is simply marked inactive, and AI features
# report themselves as unavailable).

# --- GitHub monitoring -------------------------------------------------------
# Without a token every repository resolves to a missing_token snapshot and the
# scheduler's github job stays inactive. A read-only token is enough.
GITHUB_TOKEN=

# --- AI features (alert explanations, intelligence) --------------------------
# Server-side only. Never exposed to the browser.
DEEPSEEK_API_KEY=

# --- Storage -----------------------------------------------------------------
# Override the SQLite location. Precedence:
#   DEVPULSE_DB_PATH → DEVPULSE_DB_DIR/telemetry.db → .devpulse/telemetry.db
# Useful for isolating an experimental run from your real telemetry history.
# DEVPULSE_DB_PATH=
# DEVPULSE_DB_DIR=
