# DevPulse environment template.
#
# Copy this file to `.env.local` and fill in what you use:
#
#   copy .env.example .env.local
#
# `.env.local` is git-ignored and is the only place secrets belong. Next.js
# loads it automatically for both `next dev` and `next start`, so the runtime
# launcher and the logon task never need to carry a credential.
#
# Every variable below is optional: with none of them set, DevPulse runs and
# monitors this machine locally, and the integrations that need a credential
# report themselves as inactive instead of failing.

# --- Integrations -----------------------------------------------------------

# GitHub personal access token. Optional. Without it the GitHub collector
# reports "inactive" and no GitHub API calls are made.
# Scopes: `repo` (or public-only `public_repo`) plus `read:org` if you monitor
# organization repositories.
GITHUB_TOKEN=

# DeepSeek API key. Optional. Enables Ask DevPulse, the daily brief and AI
# explanations. Without it those features report a missing key and everything
# else keeps working. Never sent anywhere except the DeepSeek API.
DEEPSEEK_API_KEY=

# --- Runtime ----------------------------------------------------------------

# Port for the production server. Optional; default 3000.
# The launcher also accepts -Port, which takes precedence.
DEVPULSE_PORT=3000

# Bind address. Optional; default 127.0.0.1 (loopback only).
# Set to 0.0.0.0 to reach the dashboard from another device on your network.
# Do not expose DevPulse directly to an untrusted network: it has NO
# authentication and anyone who can reach the port can read the dashboard and
# change its settings. The launcher prints a warning when the bind is not
# loopback. Only an IP address or a hostname is accepted here.
DEVPULSE_HOST=127.0.0.1

# --- Database ---------------------------------------------------------------

# Exact SQLite file to use. Optional; highest precedence.
# DEVPULSE_DB_PATH=

# Directory to hold `telemetry.db`. Optional; second precedence.
# Relative paths resolve against the process working directory, which the
# launcher sets to the project root.
# DEVPULSE_DB_DIR=

# With neither set, the database is <project root>/.devpulse/telemetry.db.
