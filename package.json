{
  "name": "devpulse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-runtime.ps1",
    "runtime:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-runtime.ps1 -Action Check",
    "runtime:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-runtime.ps1 -Action Status",
    "runtime:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-runtime.ps1 -Action Stop",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-autostart.ps1 -Action Install",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-autostart.ps1 -Action Status",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devpulse-autostart.ps1 -Action Remove"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
